# Optional server defaults. The UI remembers your choice for future uploads.
SEARCH_PROVIDER=linkedin
# LinkedIn Direct uses a dedicated local browser session. Click Connect LinkedIn
# in the app and sign in. No SerpApi, Serper, or other web-search engine is used.
# Own Search never calls Serper or SerpApi. Leave the paid keys blank.
# Direct fallbacks start if SearXNG is slow or lacks a usable match.
OWN_SEARCH_ENGINES=duckduckgo,brave,bing
OWN_SEARCH_SEARXNG_ENGINES=google,bing,duckduckgo,brave
OWN_SEARCH_TIMEOUT_MS=15000
OWN_SEARCH_FALLBACK_DELAY_MS=1500
# Optional access key for this app's API (local-only when blank).
OWN_SEARCH_API_KEY=
SERPER_API_KEY=
SERPAPI_API_KEY=
# SerpApi Google country and language (India / English by default).
SERPAPI_GL=in
SERPAPI_HL=en
SEARXNG_URL=http://localhost:8080
# General web engines only; comma-separated names supported by your instance.
SEARXNG_ENGINES=google,bing
